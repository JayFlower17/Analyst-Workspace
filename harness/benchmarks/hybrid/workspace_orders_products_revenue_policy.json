{
  "id": "hybrid_workspace_orders_products_revenue_policy",
  "category": "hybrid",
  "description": "Join orders and products, then apply the revenue recognition policy from a document to category revenue.",
  "tags": ["hybrid", "multi-table", "document-retrieval", "policy", "phase4-regression"],
  "setup": {
    "documents": [
      {
        "groupId": 1,
        "name": "Revenue Recognition Policy",
        "path": "harness/resources/revenue-recognition-policy.md"
      }
    ]
  },
  "request": {
    "groupId": 1,
    "focusDatasetNames": ["stage2_orders.csv", "stage2_products.csv"],
    "query": "Join the orders and products tables, summarize recognized commerce revenue by product category according to the revenue recognition policy, and explain how refunded orders are treated."
  },
  "expectations": {
    "success": true,
    "min_rows": 1,
    "required_columns_any": ["category", "product_category", "recognized_revenue", "paid_revenue", "revenue", "payment_amount"],
    "summary_contains_any": ["refunded orders were excluded", "excluded refunded", "REFUNDED", "refund", "recognized revenue", "policy"],
    "context_summary_exact": {
      "structuredSource": "WORKSPACE_SCHEMA",
      "documentSource": "DOCUMENT_RETRIEVAL",
      "semanticSource": "WORKSPACE_METADATA",
      "documentStrategy": "HEAVY"
    },
    "context_summary_min": {
      "datasetCount": 2,
      "documentChunkCount": 1,
      "documentTopK": 4,
      "documentCharBudget": 2600,
      "documentPromptChars": 1
    },
    "route_decision_exact": {
      "route": "HYBRID_ANALYSIS",
      "requiresWorkspaceContext": true,
      "requiresDocumentContext": true,
      "allowsSqlGeneration": true
    },
    "analysis_plan_step_types_exact": [
      "ROUTE_DECISION",
      "BUILD_CONTEXT",
      "RETRIEVE_DOCUMENTS",
      "GENERATE_SQL",
      "EXECUTE_SQL",
      "SUMMARIZE_RESULT"
    ],
    "analysis_report_evidence_exact": {
      "datasetCount": 2,
      "documentStrategy": "HEAVY"
    },
    "analysis_report_evidence_min": {
      "documentChunkCount": 1
    },
    "validation_report_exact": {
      "passed": true,
      "findingCount": 0
    },
    "risk_notices_exact": {
      "count": 0
    }
  }
}
