{
  "id": "hybrid_workspace_revenue_policy_document_only",
  "category": "hybrid",
  "description": "Answer a revenue policy question from workspace documents without generating SQL.",
  "tags": ["hybrid", "document-only", "document-retrieval", "policy", "phase4-regression"],
  "setup": {
    "documents": [
      {
        "groupId": 1,
        "name": "Revenue Recognition Policy",
        "path": "harness/resources/revenue-recognition-policy.md"
      }
    ]
  },
  "request": {
    "groupId": 1,
    "focusDatasetNames": ["stage2_orders.csv", "stage2_products.csv"],
    "query": "According to the revenue recognition policy, how are REFUNDED orders treated? Answer from the document only; no SQL is needed."
  },
  "expectations": {
    "success": true,
    "generated_sql_absent": true,
    "summary_contains_any": ["REFUNDED", "refunded", "excluded", "No SQL was generated", "document-only"],
    "context_summary_exact": {
      "structuredSource": "WORKSPACE_SCHEMA",
      "documentSource": "DOCUMENT_RETRIEVAL",
      "semanticSource": "WORKSPACE_METADATA",
      "documentStrategy": "HEAVY"
    },
    "context_summary_min": {
      "datasetCount": 2,
      "documentChunkCount": 1,
      "documentTopK": 4,
      "documentCharBudget": 2600,
      "documentPromptChars": 1
    },
    "route_decision_exact": {
      "route": "DOCUMENT_EXPLANATION",
      "requiresWorkspaceContext": true,
      "requiresDocumentContext": true,
      "allowsSqlGeneration": false
    },
    "analysis_plan_step_types_exact": [
      "ROUTE_DECISION",
      "BUILD_CONTEXT",
      "RETRIEVE_DOCUMENTS",
      "ANSWER_FROM_DOCUMENTS",
      "SUMMARIZE_RESULT"
    ],
    "execution_log_tool_types_exact": ["DOCUMENT_RETRIEVAL"],
    "analysis_report_evidence_exact": {
      "datasetCount": 2,
      "documentStrategy": "HEAVY"
    },
    "analysis_report_evidence_min": {
      "documentChunkCount": 1
    },
    "validation_report_exact": {
      "passed": true,
      "findingCount": 0
    },
    "risk_notices_exact": {
      "count": 0
    }
  }
}
