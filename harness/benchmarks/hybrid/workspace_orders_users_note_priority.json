{
  "id": "hybrid_workspace_orders_users_note_priority",
  "category": "hybrid",
  "description": "Join orders and users, then incorporate a workspace note about which segment to highlight first.",
  "tags": ["hybrid", "multi-table", "document-retrieval", "workspace-note", "phase4-regression"],
  "setup": {
    "documents": [
      {
        "groupId": 1,
        "name": "Workspace Analysis Note",
        "path": "harness/resources/workspace-analysis-note.md"
      }
    ]
  },
  "request": {
    "groupId": 1,
    "focusDatasetNames": ["stage2_orders.csv", "stage2_users.csv"],
    "query": "Join the orders and users tables, summarize order counts by user segment, and mention which segment should be highlighted first according to the workspace note."
  },
  "expectations": {
    "success": true,
    "min_rows": 1,
    "required_columns_any": ["segment", "user_segment", "order_count", "count", "vip_level", "total_orders"],
    "summary_contains_any": ["vip", "premium", "highest-priority", "highlighted first", "highlight first", "priority customer cohort", "L3"],
    "context_summary_exact": {
      "structuredSource": "WORKSPACE_SCHEMA",
      "documentSource": "DOCUMENT_RETRIEVAL",
      "semanticSource": "WORKSPACE_METADATA",
      "documentStrategy": "HEAVY"
    },
    "context_summary_min": {
      "datasetCount": 2,
      "documentChunkCount": 1,
      "documentTopK": 4,
      "documentCharBudget": 2600,
      "documentPromptChars": 1
    },
    "route_decision_exact": {
      "route": "HYBRID_ANALYSIS",
      "requiresWorkspaceContext": true,
      "requiresDocumentContext": true,
      "allowsSqlGeneration": true
    },
    "analysis_plan_step_types_exact": [
      "ROUTE_DECISION",
      "BUILD_CONTEXT",
      "RETRIEVE_DOCUMENTS",
      "GENERATE_SQL",
      "EXECUTE_SQL",
      "SUMMARIZE_RESULT"
    ],
    "analysis_report_evidence_exact": {
      "datasetCount": 2,
      "documentStrategy": "HEAVY"
    },
    "analysis_report_evidence_min": {
      "documentChunkCount": 1
    },
    "validation_report_exact": {
      "passed": true,
      "findingCount": 0
    },
    "risk_notices_exact": {
      "count": 0
    }
  }
}
